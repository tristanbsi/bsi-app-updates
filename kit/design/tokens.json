                 "fg": "#EDE9E4", "fg-muted": "#9C938B", "fg-faint": "#9C938B", "border": "#342F2A", "border-strong": "#463F38", "border-lit": "#4E463E" }
    },
    "patchmap": {
      "name": "PatchMap", "identity": "teal on cool grey",
      "light": { "accent": "#1A7A72", "on-accent": "#FFFFFF", "accent-ink": "#1A7A72", "accent-soft": "#DDEFEC" },
      "dark":  { "accent": "#3FB3A7", "on-accent": "#0F1A18", "accent-ink": "#3FB3A7", "accent-soft": "#16302D" }
    },
    "loader": {
      "name": "Loader", "identity": "orange on warm grey",
      "light": { "accent": "#B5540F", "on-accent": "#FFFFFF", "accent-ink": "#B5540F", "accent-soft": "#F6E3D4" },
      "dark":  { "accent": "#F0924A", "on-accent": "#1B1206", "accent-ink": "#F0924A", "accent-soft": "#3A2616" }
    }
  }
}
