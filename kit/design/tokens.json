{
  "meta": {
    "name": "BSI design tokens",
    "version": "1.0.0",
    "note": "Source of truth for kit/design/tokens.css (built by tools/build-tokens.js). Colours are hex. Every text role passes WCAG AA (4.5:1) on bg-base, bg-raised and bg-lit in both themes; tests/design.test.js checks it."
  },
  "static": {
    "space-1": "4px", "space-2": "8px", "space-3": "12px", "space-4": "16px", "space-5": "24px", "space-6": "32px", "space-7": "48px",
    "radius": "4px", "radius-control": "6px", "radius-well": "10px", "radius-pill": "999px", "chamfer": "7px", "hair": "1px",
    "font-sans": "Montserrat, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font-mono": "'IBM Plex Mono', ui-monospace, Menlo, monospace",
    "t-display": "28px", "t-title": "22px", "t-section": "19px", "t-item": "17px", "t-heading": "15px", "t-body": "14px", "t-meta": "12px",
    "lh-body": "1.5", "lh-tight": "1.25",
    "w-regular": "400", "w-medium": "500", "w-semibold": "600", "w-bold": "700",
    "ease": "cubic-bezier(.2, .7, .2, 1)", "dur-fast": "120ms", "dur-base": "160ms", "dur-slow": "300ms",
    "drain-toast": "8s", "drain-banner": "20s", "drain-caller": "60s",
    "touch": "44px", "ring": "2px",
    "tape-red": "#B8372E", "tape-yellow": "#C9A227", "tape-blue": "#3F8FD2", "tape-green": "#3FAE7A",
    "tape-orange": "#D8731F", "tape-purple": "#8E63D6", "tape-black": "#2B2F36", "tape-white": "#E6E8EB",
    "tape-black-edge": "#6C727B", "tape-fg-dark": "#0B0C0E", "tape-fg-light": "#F1F2F3"
  },
  "themes": {
    "light": {
      "bg-base": "#F4F5F6", "bg-raised": "#FFFFFF", "bg-sunken": "#E9EBEE", "bg-lit": "#FFFFFF",
      "fg": "#17191C", "fg-muted": "#4E545C", "fg-faint": "#646A73",
      "border": "#D9DCE1", "border-strong": "#C3C8CF", "border-lit": "#C3C8CF",
      "ok": "#187A49", "on-ok": "#FFFFFF", "warn": "#8F5A00", "on-warn": "#FFFFFF",
      "danger": "#C2372F", "on-danger": "#FFFFFF", "done": "#157468", "on-done": "#FFFFFF",
      "shadow": "0 1px 2px rgba(0,0,0,.06), 0 8px 24px rgba(0,0,0,.08)",
      "scrim": "rgba(23,25,28,.35)"
    },
    "dark": {
      "bg-base": "#0A0B0D", "bg-raised": "#15171B", "bg-sunken": "#050607", "bg-lit": "#2F3135",
      "fg": "#F1F2F3", "fg-muted": "#A9AFB6", "fg-faint": "#7D848C",
      "border": "#22262B", "border-strong": "#30353C", "border-lit": "#44474C",
      "ok": "#4FC38A", "on-ok": "#04211C", "warn": "#F2A93B", "on-warn": "#1A1200",
      "danger": "#F27A72", "on-danger": "#0B0C0E", "done": "#3BC0AE", "on-done": "#04211C",
      "shadow": "0 1px 2px rgba(0,0,0,.4), 0 12px 32px rgba(0,0,0,.45)",
      "scrim": "rgba(0,0,0,.5)"
    }
  },
  "apps": {
    "shopcall": {
      "name": "ShopCall", "identity": "Mineral: cold blue links and focus; each page wears its own pastel stone on the frame (kept in the Hub's Themes.html)",
      "static": { "t-body": "13.5px" },
      "light": { "accent": "#2F6FA8", "on-accent": "#FFFFFF", "accent-ink": "#2F6FA8", "accent-soft": "#E3EDF7" },
      "dark":  { "accent": "#7FB4EA", "on-accent": "#06121F", "accent-ink": "#7FB4EA", "accent-soft": "#16232F" }
    },
    "standby": {
      "name": "StandBy", "identity": "gold on warm charcoal; amber = Standby, green = Live/GO, red = over/late/lost",
      "light": { "accent": "#E0AD2E", "on-accent": "#1D1A17", "accent-ink": "#8A6200", "accent-soft": "#FBEFCC",
                 "bg-base": "#F7F5F2", "bg-raised": "#FFFFFF", "bg-sunken": "#EFEBE6", "bg-lit": "#FFFFFF",
                 "fg": "#1D1A17", "fg-muted": "#6F665E", "fg-faint": "#6F665E", "border": "#DDD6CE", "border-strong": "#C9C0B5", "border-lit": "#C9C0B5" },
      "dark":  { "accent": "#F0C75E", "on-accent": "#1D1A17", "accent-ink": "#F0C75E", "accent-soft": "#2A2418",
